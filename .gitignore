# ==============================================================================
# YouTube Automated Production Workspace .gitignore
# ==============================================================================

# External sub-repositories (managed separately via setup script)
/VoiceStudio/

# Node.js & Web build outputs
node_modules/
*/node_modules/
.next/
*/.next/
dist/
build/
out/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*/.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/

# HyperFrames temporary builds & cache
.hyperframes/
*/.hyperframes/

# Render outputs, exports & generated media
renders/
*/renders/
exports/
*/exports/
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.flv

# Specific video projects and topic folders
gta*/
*/gta*
scripts/gta*/
research/gta*/

# Keep the base voice sample profile for cloning, ignore temporary raw recordings
assets/voices/*_raw.*
assets/voices/*_48k.*
assets/voices/*_8s.*
!assets/voices/creator_sample.wav

# Environment variables & secrets
.env
.env*.local
*.pem
*.key

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~


