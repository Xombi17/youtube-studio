# ==============================================================================
# CreatorRadar YouTube Studio Engine .gitignore
# STRICT POLICY: ONLY THE ENGINE IS TRACKED IN GIT.
# All video projects, topic folders, renders, exports, and generated media are ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# Video Projects (Working directories for individual video productions)
# ------------------------------------------------------------------------------
projects/*
!projects/README.md
!projects/.gitkeep
project/
project/*
video-*/
*/video-*
topic-*/
*/topic-*
gta*/
*/gta*

# ------------------------------------------------------------------------------
# Renders & Master Exports
# ------------------------------------------------------------------------------
renders/*
!renders/README.md
!renders/.gitkeep
exports/*
!exports/README.md
!exports/.gitkeep

# ------------------------------------------------------------------------------
# Topic Research & Topic Scripts
# ------------------------------------------------------------------------------
research/*
!research/README.md
scripts/projects/
scripts/temp/
scripts/gta*/

# ------------------------------------------------------------------------------
# Video Pipeline Intermediate Asset Folders
# ------------------------------------------------------------------------------
frames/
*/frames/
clips/
*/clips/
conformed/
*/conformed/
padded/
*/padded/
qc_stills/
*/qc_stills/
review_samples/
*/review_samples/
subs/
*/subs/
scenes/
*/scenes/
scenes_v2/
*/scenes_v2/
audio/
*/audio/
out/
*/out/
proj/
*/proj/

# ------------------------------------------------------------------------------
# Media & Audio Binaries
# ------------------------------------------------------------------------------
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.flv
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.flac

# Preserve core engine voice clone profile & studio SFX pack:
!assets/voices/creator_sample.wav
!assets/sfx/
!assets/sfx/*

# Ignore temporary raw voice recordings & calibration dumps:
assets/voices/*_raw.*
assets/voices/*_48k.*
assets/voices/*_8s.*
assets/voices/*.temp.*

# ------------------------------------------------------------------------------
# HyperFrames, Cache & Temporary Artifacts
# ------------------------------------------------------------------------------
.hyperframes/
*/.hyperframes/
.thumbnails/
*/.thumbnails/
.waveform-cache/
*/.waveform-cache/

# ------------------------------------------------------------------------------
# External Sub-Repositories & Tools
# ------------------------------------------------------------------------------
/VoiceStudio/
/youtube-agent-skill/
/external/
.claude/skills/claude-video-2
.claude/skills/slop-monster
.claude/skills/power-design
.claude/skills/impeccable
.claude/skills/taste-skill
.claude/skills/hyperframes*
.claude/skills/remotion-to-hyperframes
.claude/skills/reverse-any-video

# ------------------------------------------------------------------------------
# Node.js & Web Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.next/
*/.next/
dist/
build/
out/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# Python Virtual Environments, Bytecode & Cache
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*/.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
*.pem
*.key
client_secret*.json
token*.json
config/youtube_client_secret.json
config/youtube_client_secret*.json
config/youtube_token.json
config/youtube_accounts.json
config/client_secret*.json
config/youtube_token*.json
config/gmail_smtp.json

# ------------------------------------------------------------------------------
# Logs & Temp Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# OS & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
